{
  "name": "visit-ready",
  "version": "0.1.0",
  "private": true,
  "description": "Visit Ready — multilingual clinical trial navigation and preparation tool (Hackachusetts 2026). Person B: data pipeline, safety, and tests.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest",
    "refresh-cache": "tsx scripts/refresh-cache.ts",
    "verify-live": "tsx scripts/verify-live-adapter.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fast-check": "^3.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
